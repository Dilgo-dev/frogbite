{
  "$schema": "https://raw.githubusercontent.com/nicedouble/tauri-apps-fork/main/.schema/config.schema.json",
  "productName": "frogbite",
  "version": "0.1.0",
  "identifier": "dev.frogbite.app",
  "build": {
    "frontendDist": "app/frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd app/frontend && bun run dev",
    "beforeBuildCommand": "cd app/frontend && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "frogbite",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  }
}
